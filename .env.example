# Example environment configuration
# Update values as needed and rename to ".env" for local development

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@db:5432/wealthmachine

# No working credentials supplied; blank configuration refuses startup.
# No token issuer or founder enrollment. Synthetic keys live only in tests.
JWT_SECRET_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
WEALTHMACHINE_SIGNING_KEY=

# Deployment environment (development or production)
ENVIRONMENT=development

# Metrics use authenticated /metrics, not a second unauthenticated port.
